#
# Xiaomi AX9000 (IPQ8072, 1 GB) — one board, one image set.
#
# Concatenated onto devices/common/config by prepare-build.sh. The board
# used to sit in devices/ipq807x-1g with the rest of the 1 GB ipq807x
# boards; it builds on its own because what it needs is its own:
# CONFIG_TARGET_PER_DEVICE_ROOTFS sorts only DEVICE_PACKAGES by board, so
# a package selected at image level lands in every board that shares the
# build. The fan control belongs to a board with a fan, and the full
# variants of dnsmasq and iproute2 are this build's choice, not the
# 256 MB boards'.
#

CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax9000=y

## Active cooling.
##
## The board's fan sits behind a Microchip EMC2305 on a QUP I2C bus
## (blsp1_i2c6, address 0x2f) and the board's DTS binds that fan as a cooling
## device to the CPU thermal zones.
##
## kmod-hwmon-emc2305 is that driver, and the package is what to name here:
## CONFIG_SENSORS_EMC2305 is not a symbol of OpenWrt's .config at all - it goes
## into the kernel from the kmod's KCONFIG line, always as a module. Asking for
## the kernel symbol instead would have defconfig drop it and the build stop.
## =y builds emc2305.ko and installs it in this image (and keeps it in the kmod
## feed); the board's DEVICE_PACKAGES name the same package, and the kmod's
## AUTOLOAD probes it at boot.
CONFIG_PACKAGE_kmod-hwmon-emc2305=y

## alpine-fan-control from the alpinefancontrol feed (see build.yml's feeds): a
## two-point fan curve read from the cpu0 thermal zone, written to the fan
## either through the driver's hwmon pwm1 or straight to the EMC2305's Fan Drive
## register over I2C. The feed ships the AX9000 values and the I2C method as its
## default, and it is the one worth keeping: the daemon writes the full 8-bit
## register, where the kernel's PWM steps on this board are coarse.
##
## i2c-tools is that path's tool, and a DEPENDS of the daemon; named here so the
## image keeps it when pwm_method is set back to sysfs.
CONFIG_PACKAGE_alpine-fan-control=y
CONFIG_PACKAGE_luci-app-alpine-fan-control=y
CONFIG_PACKAGE_i2c-tools=y

## Full variants of what the target ships small. Each pair provides one name -
## ip, tc, dnsmasq - so apk cannot hold both: the variant the rest of the build
## takes is switched off by hand, the way devices/common/config switches off
## dropbear and wpad-basic-mbedtls. The small ones come in on their own: dnsmasq
## is in the target's DEFAULT_PACKAGES.router, and ip-tiny and tc-tiny are the
## DEFAULT_VARIANT of iproute2, which is what sqm-scripts' +ip and +tc resolve
## to - tc-tiny is also named in the common config.
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-tiny=n
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tc-tiny=n
CONFIG_PACKAGE_tc-full=y

## tc classes and actions. There is no kmod-sched-flow and no
## kmod-sched-act-mirred package in the tree: cls_flow (CONFIG_NET_CLS_FLOW) and
## act_mirred (CONFIG_NET_ACT_MIRRED) ship inside kmod-sched-core, the core
## qdisc/class/action set every tc variant depends on. Asked for by name so the
## image keeps them whatever the tc variant resolves to; the flower classifier
## and the actions the PPE offload drives are selected in devices/common/config.
CONFIG_PACKAGE_kmod-sched-core=y
